NEXT_PUBLIC_SITE_URL=https://inovixadigital.com

# Where "Book a Call" links go — a Calendly (or other scheduler) event URL.
# Leave unset to fall back to the /contact page.
NEXT_PUBLIC_BOOKING_CALL_URL=

RESEND_API_KEY=
AUDIT_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

NEXT_PUBLIC_GA_ID=

# Ownership verification codes for Google Search Console and Bing Webmaster
# Tools. Get these from each tool's "HTML tag" verification method (just the
# content value, not the full <meta> tag) and the site verifies itself —
# no file upload needed. Leave unset until you've created both properties.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Powers lead storage (audit + contact form submissions) and the /admin
# dashboard. See supabase/schema.sql for the table to create, and the
# README's "Admin Dashboard" section for full setup steps. Both values are
# from Supabase's Project Settings -> API Keys page. The secret key must
# stay server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
