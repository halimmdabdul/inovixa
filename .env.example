NEXT_PUBLIC_SITE_URL=https://inovixadigital.com

RESEND_API_KEY=
AUDIT_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# The GA Measurement ID and Search Console / Bing verification codes below
# are only used as a fallback default. Once Supabase is configured (see
# below), the real place to set/change these is /admin/settings — it takes
# effect immediately, with no redeploy needed. Leave these three unset
# unless you specifically want an env-var default before Supabase is set up.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Powers lead storage (audit + contact form submissions) and the /admin
# dashboard. See supabase/schema.sql for the table to create, and the
# README's "Admin Dashboard" section for full setup steps. Both values are
# from Supabase's Project Settings -> API Keys page. The secret key must
# stay server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
